{
  "name": "@loafpickleww/bread-line",
  "version": "0.2.0",
  "description": "A daily remote job radar: fetches 150+ job boards, filters to your roles, and has Claude Code or Codex score each job against your resume.",
  "keywords": [
    "jobs",
    "job-search",
    "job-board",
    "resume",
    "claude-code",
    "codex",
    "agent-skills",
    "remote-jobs"
  ],
  "homepage": "https://jobs.loafpickle.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoafPickleWW/bread-line.git"
  },
  "bugs": {
    "url": "https://github.com/LoafPickleWW/bread-line/issues"
  },
  "author": "LoafPickle Worldwide LLC (https://loafpickle.com)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bread-line": "cli/bread-line.js"
  },
  "files": [
    "cli/",
    "src/",
    "scripts/",
    "!scripts/build-kit.js",
    "!scripts/sync-codex-plugin.js",
    "tracker/",
    "profiles/_template/",
    ".claude/skills/",
    ".agents/skills/",
    "AGENTS.md",
    "RUNBOOK.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "radar": "node src/fetch.js",
    "radar:dry": "node src/fetch.js --dry",
    "discover": "node scripts/discover.js",
    "show": "node scripts/show.js",
    "tracker:prep": "node scripts/to-tracker.js",
    "digest": "node scripts/digest.js",
    "radar:commit": "node scripts/commit.js",
    "profile:new": "node scripts/new-profile.js",
    "profile:check": "node scripts/check-profile.js",
    "tracker:local": "node scripts/to-local.js",
    "kit": "node scripts/sync-codex-plugin.js && node scripts/build-kit.js",
    "save-scores": "node scripts/save-scores.js",
    "tracker:scores": "node scripts/scores-to-tracker.js",
    "tracker:page": "node scripts/tracker-page.js",
    "plugins:sync": "node scripts/sync-codex-plugin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
